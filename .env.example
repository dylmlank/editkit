# Copy this file to ".env", paste your OpenRouter API key, and pick a model.
# Get a key at https://openrouter.ai/keys (starts with sk-or-v1-...).
# Generation runs through OpenRouter's OpenAI-compatible endpoint, so ANY
# OpenRouter model works — but it MUST support tool calling. Browse free,
# tool-capable models: https://openrouter.ai/models?supported_parameters=tools&max_price=0
OPENROUTER_API_KEY=sk-or-v1-...
EDITKIT_MODEL=openai/gpt-oss-120b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # default; override if needed
